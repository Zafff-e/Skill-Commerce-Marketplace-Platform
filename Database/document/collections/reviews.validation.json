{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["_id", "bookingId", "customerId", "providerId", "rating", "createdAt"],
    "properties": {
      "_id": { "bsonType": "string" },
      "bookingId": { "bsonType": "string" },
      "customerId": { "bsonType": "string" },
      "providerId": { "bsonType": "string" },
      "rating": {
        "bsonType": "int",
        "minimum": 1,
        "maximum": 5
      },
      "feedback": { "bsonType": "string" },
      "workPhotos": {
        "bsonType": "array",
        "items": { "bsonType": "string" }
      },
      "aspectScores": {
        "bsonType": "object",
        "properties": {
          "punctuality": { "bsonType": "int", "minimum": 1, "maximum": 5 },
          "cleanliness": { "bsonType": "int", "minimum": 1, "maximum": 5 },
          "technicalCompetence": { "bsonType": "int", "minimum": 1, "maximum": 5 }
        }
      },
      "createdAt": { "bsonType": "date" }
    }
  }
}
