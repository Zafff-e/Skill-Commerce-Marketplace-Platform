# SkillCommerce / Kaarigor Customer Portal - Environment Variables

# API mode: 'live' uses real ASP.NET Core backend endpoints, 'demo' runs with local seed fallback
VITE_APP_MODE=live

# Base URL of the ASP.NET Core Web API (Production URL or Render/Railway/Azure endpoint)
VITE_API_BASE_URL=https://api.kaarigor.com

# URL of the Angular Provider Portal & Back-Office Workspace
VITE_PROVIDER_ORIGIN=https://provider.kaarigor.com

